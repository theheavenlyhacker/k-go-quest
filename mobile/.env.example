# Clerk publishable key for the Caretaker sign-in at Setup (Clerk dashboard > API keys).
# Publishable only. Never put the Clerk secret key in the app or in this repo.
# Copy to .env.local (git-ignored) and fill in.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# The backend address, for Online Mode. HTTPS only outside development.
# Left unset in a release build, the tablet stays offline for good: practice,
# grading, Mastery, Coins and Growth all still work, but nothing uploads, the
# League is empty and no Content Pack can be downloaded. Set it per EAS build
# profile, or here before a local build.
EXPO_PUBLIC_API_URL=https://api.example.ph/api/v1
