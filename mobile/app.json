{
  "expo": {
    "name": "K-Go Quests",
    "slug": "k-go-quests-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kgoquestsmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "ph.kgoquests.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0C4A3E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C4A3E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 190
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "style": "light"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow K-Go Quests to read Quiz Paper QR codes. No photos are saved.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "style": "light",
        "hidden": true
      },
      "eas": {
        "projectId": "029dd0bc-351a-4a15-b937-17fa85d621cf"
      }
    }
  }
}
