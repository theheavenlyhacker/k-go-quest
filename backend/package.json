{
  "name": "khan-go-quests-backend",
  "version": "0.0.1",
  "description": "Offline-first educational API for Students, Teachers, and LGU Admins",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node scripts/test-postgres.cjs",
    "db:migrate": "ts-node src/database/migrate.ts",
    "db:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/migration-source.ts",
    "db:bootstrap": "ts-node src/database/bootstrap.ts",
    "db:seed": "ts-node src/database/seed.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test -- --runInBand && npm run db:export && npm run build && npm run test:integration",
    "test:integration": "node scripts/test-postgres.cjs",
    "db:export": "node scripts/export-schema.cjs",
    "db:check": "ts-node src/database/check.ts",
    "smoke:configured": "node scripts/smoke-configured.cjs",
    "migration:run": "ts-node ./node_modules/typeorm/cli.js migration:run -d src/database/typeorm-cli.ts",
    "migration:revert": "ts-node ./node_modules/typeorm/cli.js migration:revert -d src/database/typeorm-cli.ts",
    "prod:migrate": "node dist/database/migrate.js",
    "prod:check": "node dist/database/check.js",
    "prod:bootstrap": "node dist/database/bootstrap.js",
    "bootstrap": "ts-node src/database/bootstrap.ts",
    "seed": "ts-node src/database/seed.ts",
    "model:import": "ts-node src/database/import-model.ts",
    "pack:import": "ts-node src/database/import-pack.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.5",
    "helmet": "^8.3.0",
    "joi": "^18.2.9",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "jest": "^30.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2"
  },
  "optionalDependencies": {
    "@embedded-postgres/windows-x64": "^18.4.0-beta.17"
  }
}
