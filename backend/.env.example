NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://kgo:replace-with-local-db-password@localhost:5432/kgo
DATABASE_SSL=false
DATABASE_SCHEMA=kgo
DATABASE_CA_PATH=
POSTGRES_PASSWORD=replace-with-local-db-password
# Generate: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-48-characters
JWT_ISSUER=kgo-quests
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
SWAGGER_ENABLED=true
TRUST_PROXY_HOPS=0
# Bootstrap runs once from the CLI, never from an HTTP endpoint.
BOOTSTRAP_LOGIN=admin-demo
BOOTSTRAP_PASSWORD=replace-with-a-strong-unique-password
BOOTSTRAP_JURISDICTION=Demo LGU
DEMO_PASSWORD=replace-with-a-different-strong-password
