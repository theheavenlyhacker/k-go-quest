# Demo defaults: every value below is a throwaway for a localhost-only stack,
# so `cp .env.example .env && docker compose up` works as is. Never reuse them
# for anything reachable from a network; see ../docs/deployment.md for real ones.
NODE_ENV=development
PORT=3000
# Host-side URL, used by `npm run db:seed:demo` and other CLIs. Compose points
# the containers at the db service itself and reuses POSTGRES_PASSWORD.
DATABASE_URL=postgresql://kgo:demo-local-only-db-password@localhost:5432/kgo
DATABASE_SSL=false
DATABASE_SCHEMA=kgo
DATABASE_CA_PATH=
# Or paste the CA itself, for a platform with nowhere to put a file (Railway, Render, Fly).
# Only one of the two is needed. TLS verification stays on either way.
DATABASE_CA=
POSTGRES_PASSWORD=demo-local-only-db-password
# Generate: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=demo-local-only-jwt-secret-not-for-any-real-deployment-0123456789
JWT_ISSUER=kgo-quests
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
SWAGGER_ENABLED=true
TRUST_PROXY_HOPS=0
# Bootstrap runs once from the CLI, never from an HTTP endpoint. Not needed for
# the demo stack: `npm run db:seed:demo` provisions admin-demo itself.
BOOTSTRAP_LOGIN=admin-demo
BOOTSTRAP_PASSWORD=replace-with-a-strong-unique-password
BOOTSTRAP_JURISDICTION=Demo LGU
# Password of every demo account (admin-demo, teacher-demo, learner-01 ...).
DEMO_PASSWORD=demo-local-only-password
# Model service (../ml). It refuses to start with a token under 24 characters.
KGO_ML_TOKEN=demo-local-only-ml-token-0123456789
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TOKEN=demo-local-only-ml-token-0123456789
