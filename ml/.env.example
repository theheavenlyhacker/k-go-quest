# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
KGO_ML_TOKEN=replace-with-at-least-24-characters
# Same database the backend uses. Aiven needs sslmode=require.
DATABASE_URL=postgresql://avnadmin:...@...aivencloud.com:12590/defaultdb?sslmode=require
# Must match DATABASE_SCHEMA in the backend's .env.
DATABASE_SCHEMA=kgo
